# Python
venv/
__pycache__/
*.pyc
*.pyo

# Downloaded data, trained models and generated charts:
# these are regenerated by running the pipeline, no need to commit them
data/*.csv
models/*.pkl
outputs/*.png

# Keep the folders themselves tracked in git even though contents are ignored
!data/.gitkeep
!models/.gitkeep
!outputs/.gitkeep

# Files delivered into the chat by Claude (screenshots, scratch copies).
# Useful locally, not part of the project.
Claude outputs/

# OS junk
.DS_Store
Thumbs.db

# Editor junk
.vscode/
.idea/
.cursor/
